{
  "name": "butler-service-frontend-tools",
  "private": true,
  "version": "1.0.0",
  "description": "Инструменты фронтенда: линтер, сценарии и обход разделов в Playwright, снимки интерфейса",
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings=0 static/js static/sw.js",

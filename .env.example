# Скопируйте в .env и заполните под себя:  cp .env.example .env
# База данных: SQLite по умолчанию; для продакшена — PostgreSQL
DATABASE_URL=sqlite:///./timetrack.db
# DATABASE_URL=postgresql+psycopg2://timetrack:SECRET@127.0.0.1:5432/timetrack

# Секрет подписи сессий. Обязательно замените:  openssl rand -hex 32
SECRET_KEY=change-me-in-production-please-use-long-random-string

# Часовой пояс объекта (влияет на «сегодня», окна отметок и табель)
APP_TZ=Europe/Moscow

# 1 — когда сайт открыт по HTTPS (cookie только по TLS)
# COOKIE_SECURE=1

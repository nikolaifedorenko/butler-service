# Скопируйте в .env и заполните под себя:  cp .env.example .env
# База данных, по старшинству: DATABASE_URL → POSTGRES_* → SQLite-файл SQLITE_PATH.
# SQLite по умолчанию (./timetrack.db); для продакшена — PostgreSQL. POSTGRES_* надёжнее
# DATABASE_URL: приложение само экранирует пароль (любые символы, в т.ч. @ : / # %).
# SQLITE_PATH=./timetrack.db
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=timetrack
# POSTGRES_PASSWORD=
# POSTGRES_DB=timetrack
# DATABASE_URL=postgresql+psycopg2://timetrack:SECRET@127.0.0.1:5432/timetrack

# Секрет подписи сессий. ОБЯЗАТЕЛЬНО задайте:  openssl rand -hex 32
# Пустой или взятый из примера ключ не позволит приложению запуститься
# (локально можно разрешить флагом ALLOW_INSECURE_DEV_SECRET=1).
# ./run.sh создаёт .env с надёжным ключом автоматически.
SECRET_KEY=

# Ключ шифрования секретов уведомлений в БД (токен Telegram-бота, пароль SMTP) — Fernet.
# Без него секреты не сохранить. Сгенерировать:
#   python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Смена ключа: NOTIFY_SECRET_KEY=новый,старый — при старте всё перешифруется новым.
# Потерян ключ — токен и пароль вводятся заново в «Настройки → Чаты и Почта».
# ./run.sh создаёт .env с ключом автоматически.
NOTIFY_SECRET_KEY=

# Часовой пояс объекта (влияет на «сегодня», окна отметок и табель)
APP_TZ=Europe/Moscow

# 1 — когда сайт открыт по HTTPS (cookie только по TLS)
# COOKIE_SECURE=1

# Срок жизни сессии в часах (по умолчанию 48)
# SESSION_TTL_HOURS=48

# CSRF-защита (double-submit). Не выключайте на стенде с браузерами: 0 нужен только тестам
# CSRF_ENABLED=1

# Демо-режим «войти как сотрудник» без пароля. Включён по умолчанию (решение
# владельца от 15.10.2026); поставьте 0, если на этом стенде функция не нужна.
ALLOW_IMPERSONATION=1

# Пустая база при первом старте: пароль администратора admin (не короче 8 символов).
# DEMO_SEED=1 — вместо этого демо-сотрудники с паролем demo1234 (только для демо и разработки;
# ./run.sh включает его сам).
ADMIN_PASSWORD=
# DEMO_SEED=1

# Адрес Telegram Bot API, если бот работает через корпоративный прокси (из интерфейса не
# меняется — защита токена бота). Пусто — сохранённое значение или https://api.telegram.org
# NOTIFY_TELEGRAM_API=https://tg-proxy.example.local

# 1 — брать IP клиента из X-Forwarded-For (rate-limit входа). Включать ТОЛЬКО
# за своим доверенным reverse-proxy (например, nginx из docker-compose.prod.yml),
# иначе заголовок подделывается клиентом.
TRUST_PROXY_HEADERS=0

# 1 — CSP в режиме Report-Only (браузер предупреждает, но не блокирует).
# 0 (по умолчанию) — полноценная блокирующая Content-Security-Policy.
CSP_REPORT_ONLY=0

# Наблюдаемость (продакшен): JSON-лог запросов и /metrics (Prometheus).
# LOG_JSON=1
# METRICS_ENABLED=1

# Swagger /api/docs и схема /api/openapi.json: по умолчанию включены, в прод-профиле — 0.
# API_DOCS=0

# 1 (по умолчанию) — воркер сам мигрирует схему при старте; 0 — только сверяет ревизию, а
# миграции делает шаг `python -m app.bootstrap.migrate` (так работает прод-профиль, ADR-0002)
# MIGRATE_ON_START=1

# Фоновая синхронизация ночных отчётов: досоздание смен и автозакрытие в 08:00, период в секундах
# NIGHT_SYNC_ENABLED=1
# NIGHT_SYNC_SECONDS=60

# Свой TTF-шрифт для PDF, если DejaVu из assets/fonts не подходит
# PDF_FONT=/путь/шрифт.ttf

# Бэкапы прод-профиля (deploy/README.md §4): открытый ключ age — копии шифруются им;
# закрытый ключ хранится ВНЕ сервера. Второй сервер для копий — по SSH (deploy/backup-ssh/).
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_REMOTE=user@backup-host:/srv/butler-backups/

# Переменные прод-профиля (UVICORN_WORKERS, POSTGRES_*, BACKUP_*) — в таблице deploy/README.md §3.

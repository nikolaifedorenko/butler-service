; Контракты импортов (lint-imports) — Python-аналог архитектурных тестов движка
; (tests/engine/test_architecture.py) для остального приложения.
;
; Ред. 20.10.2026 (фаза C1, EXECUTION-SPEC-v2): добавлен слой app.core —
; инфраструктурное ядро (config/db/time/errors/security/auth/permissions/audit/
; media/identity/format/observability). Правило R5: core не импортирует ничего
; из приложения; composition root (main, bootstrap) — единственные всезнающие слои.
; Законы ADR-0006 для остального сохранены: api → services → models; api-модули
; независимы; движок изолирован от HTTP-слоя и сервисов.

[importlinter]
root_packages =
    app

[importlinter:contract:app-layers]
name = Слои приложения: api над services, services над models, models над core
type = layers
layers =
    app.api
    app.services
    app.models
    app.core
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee (runtime — db.get("Employee", …)),
    ; см. пояснение в contract:core-independence
    app.core.auth -> app.models

[importlinter:contract:api-independence]
name = API-модули не импортируют друг друга (общее — только services/core)
type = independence
modules =
    app.api.access_api
    app.api.audit_api
    app.api.auth_routes
    app.api.cars_api
    app.api.docs_api
    app.api.doublepay
    app.api.employees
    app.api.engine_settings_api
    app.api.fact_api
    app.api.mgmt_api
    app.api.night_api
    app.api.notify_api
    app.api.photos_api
    app.api.presence_api
    app.api.punches
    app.api.schedule
    app.api.settings_api
    app.api.tabel_api

[importlinter:contract:engine-isolation]
name = Движок v7.1 не знает про api/services/main/bootstrap
type = forbidden
source_modules =
    app.engine
forbidden_modules =
    app.api
    app.services
    app.bootstrap
    app.main

[importlinter:contract:core-independence]
name = R5 — core не знает о приложении (модули, модели каталога, composition root)
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.api
    app.services
    app.models
    app.engine
    app.notify
    app.bootstrap
    app.main
    app.base_schedule
    app.cars
    app.doc_render
    app.doc_templates
    app.doublepay
    app.employment
    app.engine_bootstrap
    app.grid_docx
    app.groups
    app.names
    app.night
    app.night_export
    app.pdf_render
    app.schedule_helpers
    app.schedule_patterns
    app.shiftrev
    app.tabel_fill
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee: в runtime Employee загружается
    ; внедрённым bootstrap'ом колбэком (set_employee_loader), импорта моделей нет.
    app.core.auth -> app.models

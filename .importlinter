; Контракты импортов (lint-imports) — Python-аналог архитектурных тестов движка
; (tests/engine/test_architecture.py) для остального приложения.
;
; Ред. 20.10.2026 (фаза C3, EXECUTION-SPEC-v2): второй модуль — app.modules.notify
; (эталон: 5 слоёв, R1–R6 без транзитных послаблений внутри модуля); Setting
; (кросс-модульное key-value хранилище) переехал в app/core/settings_store.py.
; Ред. 20.10.2026 (фаза C2, EXECUTION-SPEC-v2): создан первый модуль —
; app.modules.timesheet (бывший app/engine + табельные роутеры + хелперы +
; ORM-модели punch/schedule/engine_store/directory). Контракты:
;   1) слои legacy-приложения (api → services → models → core);
;   2) независимость api-модулей;
;   3) изоляция timesheet (бывшая изоляция движка): модуль не знает про
;      api/services/composition root;
;   4) R5 — core не импортирует приложение;
;   5) независимость роутеров внутри timesheet.interface (правопреемник п.2);
;   6) ТРАНЗИТНЫЙ контракт (§11.2 G3): legacy app.* не импортирует modules.*,
;      кроме composition root (main/bootstrap — не в источниках) и явных
;      исключений, которые сокращаются по мере переноса модулей (C4–C6).
; Направление modules.* → app.* (ещё не перенесённый legacy: groups, employment,
; doc_render, grid_docx, pdf_render, models.night/notify/cars) разрешено транзитным
; контрактом G3 — до переноса владеющих модулей.

[importlinter]
root_packages =
    app

[importlinter:contract:app-layers]
name = Слои приложения: api над services, services над models, models над core
type = layers
layers =
    app.api
    app.services
    app.models
    app.core
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee (runtime — db.get("Employee", …)),
    ; см. пояснение в contract:core-independence
    app.core.auth -> app.models

[importlinter:contract:api-independence]
name = API-модули не импортируют друг друга (общее — только services/core)
type = independence
modules =
    app.api.access_api
    app.api.audit_api
    app.api.auth_routes
    app.api.cars_api
    app.api.docs_api
    app.api.photos_api
    app.api.settings_api

[importlinter:contract:timesheet-isolation]
name = Модуль timesheet (движок v7.1) не знает про api/services/main/bootstrap
type = forbidden
source_modules =
    app.modules.timesheet
forbidden_modules =
    app.api
    app.services
    app.bootstrap
    app.main

[importlinter:contract:core-independence]
name = R5 — core не знает о приложении (модули, legacy-корень, composition root)
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.api
    app.services
    app.models
    app.modules
    app.bootstrap
    app.main
    app.cars
    app.doc_render
    app.doc_templates
    app.grid_docx
    app.pdf_render
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee: в runtime Employee загружается
    ; внедрённым bootstrap'ом колбэком (set_employee_loader), импорта моделей нет.
    app.core.auth -> app.models

[importlinter:contract:timesheet-interface-independence]
name = Роутеры timesheet.interface не импортируют друг друга (правопреемник api-independence)
type = independence
modules =
    app.modules.timesheet.interface.doublepay
    app.modules.timesheet.interface.engine_settings_api
    app.modules.timesheet.interface.fact_api
    app.modules.timesheet.interface.mgmt_api
    app.modules.timesheet.interface.presence_api
    app.modules.timesheet.interface.punches
    app.modules.timesheet.interface.schedule
    app.modules.timesheet.interface.tabel_api

[importlinter:contract:transit-app-to-modules]
name = Транзит (G3): legacy app.* не импортирует modules.* кроме объявленных исключений
type = forbidden
source_modules =
    app.api
    app.services
    app.models
    app.cars
    app.doc_render
    app.doc_templates
    app.grid_docx
    app.pdf_render
forbidden_modules =
    app.modules
ignore_imports =
    ; Фасад app/models: транзитный re-export переехавших ORM-моделей (спека §7
    ; фазы 4–5). Уменьшается в C4–C6, удаляется вместе с пакетом app/models/.
    app.models -> app.modules.timesheet.adapters.orm
    app.models -> app.modules.notify.adapters.orm
    app.models -> app.modules.employees.adapters.orm
    app.models.cars -> app.modules.employees.application.catalog
    ; docs/grid_docx и doc_render потребляют names/groups через границу employees (до C4d)
    app.doc_render -> app.modules.employees.application
    app.grid_docx -> app.modules.employees.application
    ; До C4: легаси-потребители модулей через их границы (R3-направление).
    ; Строки исчезают по мере переноса владельцев (employees — перенесён в C4a).
    app.api.settings_api -> app.modules.timesheet.application.base_schedule
    app.api.settings_api -> app.modules.timesheet.application.schedule_helpers
    app.api.settings_api -> app.modules.timesheet.adapters.sql_settings
    app.api.auth_routes -> app.modules.timesheet.application.punch_plan
    app.models -> app.modules.night.adapters.orm
    app.models.cars -> app.modules.night.application.catalog

[importlinter:contract:notify-isolation]
name = Эталон (C3): notify не знает про legacy-приложение и composition root
type = forbidden
source_modules =
    app.modules.notify
forbidden_modules =
    app.api
    app.services
    app.models
    app.bootstrap
    app.main
    app.modules.timesheet
    app.cars
    app.doc_render
    app.doc_templates
    app.grid_docx
    app.pdf_render
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee — ребро core → фасад моделей,
    ; а не зависимость notify (в runtime Employee загружается колбэком, C1);
    ; фасад app/models — транзитный re-export (удаляется в C6 вместе с фасадом).
    app.core.auth -> app.models
    app.models -> app.modules.timesheet.adapters.orm

[importlinter:contract:timesheet-private]
name = R3: domain/adapters/interface timesheet приватны (другие модули — только application/ports)
type = forbidden
source_modules =
    app.modules.employees
    app.modules.notify
    app.modules.night
forbidden_modules =
    app.modules.timesheet.domain
    app.modules.timesheet.adapters
    app.modules.timesheet.interface
; R3 — про ПРЯМЫЕ импорты: внутри чужого модуля application → domain — его
; собственное дело, транзитивная цепочка через application легальна.
allow_indirect_imports = True

[importlinter:contract:employees-private]
name = R3: domain/adapters/interface employees приватны (другие модули — только application/ports)
type = forbidden
source_modules =
    app.modules.timesheet
    app.modules.notify
    app.modules.night
forbidden_modules =
    app.modules.employees.domain
    app.modules.employees.adapters
    app.modules.employees.interface
allow_indirect_imports = True

[importlinter:contract:night-private]
name = R3: domain/adapters/interface night приватны (другие модули — только application/ports)
type = forbidden
source_modules =
    app.modules.timesheet
    app.modules.employees
    app.modules.notify
forbidden_modules =
    app.modules.night.domain
    app.modules.night.adapters
    app.modules.night.interface
allow_indirect_imports = True

[importlinter:contract:notify-private]
name = R3: domain/adapters/interface notify приватны (другие модули — только application/ports)
type = forbidden
source_modules =
    app.modules.timesheet
    app.modules.employees
    app.modules.night
forbidden_modules =
    app.modules.notify.domain
    app.modules.notify.adapters
    app.modules.notify.interface
allow_indirect_imports = True

; Контракты импортов (lint-imports) — Python-аналог архитектурных тестов движка
; (tests/engine/test_architecture.py).
;
; Ред. 20.10.2026 (фаза C4 — финал модульного переноса): legacy-пакеты app/api,
; app/services, app/models удалены; приложение = core/ + bootstrap/ + main +
; 9 модулей (timesheet, employees, night, cars, docs, notify, settings, access,
; audit). Транзитные контракты G3 сняты — все потребители ходят через границы
; application/ports (R3). Контракты:
;   1) R5 — core не импортирует модули и composition root;
;   2) изоляции timesheet/notify — модули не знают composition root;
;   3) независимость роутеров внутри timesheet.interface и access.interface;
;   4) R3 — приватные слои каждого модуля (domain/adapters/interface) не
;      импортируются другими модулями; публичны только application/ports.
; Контракты, где перечислены модули (изоляция notify и R3), генерирует
; tools/gen_importlinter.py из манифестов (шаг 5.4, 22.10.2026) — ниже маркера.
; Финальная доводка R1–R6 (AST-покрытие всех модулей) — фаза C7 (DoD).

[importlinter]
root_packages =
    app

[importlinter:contract:core-independence]
name = R5 — core не знает о модулях и composition root
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
    app.bootstrap
    app.main
ignore_imports =
    ; TYPE_CHECKING-аннотация Principal.employee: в runtime Employee загружается
    ; внедрённым bootstrap'ом колбэком (set_employee_loader), импорта моделей нет.
    app.core.auth -> app.modules.employees.application.catalog

[importlinter:contract:timesheet-isolation]
name = Модуль timesheet (движок v7.1) не знает про composition root
type = forbidden
source_modules =
    app.modules.timesheet
forbidden_modules =
    app.bootstrap
    app.main
allow_indirect_imports = True

[importlinter:contract:timesheet-interface-independence]
name = Роутеры timesheet.interface не импортируют друг друга
type = independence
modules =
    app.modules.timesheet.interface.doublepay
    app.modules.timesheet.interface.engine_settings_api
    app.modules.timesheet.interface.fact_api
    app.modules.timesheet.interface.mgmt_api
    app.modules.timesheet.interface.presence_api
    app.modules.timesheet.interface.punches
    app.modules.timesheet.interface.schedule
    app.modules.timesheet.interface.tabel_api

[importlinter:contract:access-interface-independence]
name = Роутеры access.interface не импортируют друг друга
type = independence
modules =
    app.modules.access.interface.access_api
    app.modules.access.interface.auth_routes

; ── ниже — генерирует tools/gen_importlinter.py из app/modules/*/manifest.py, руками не править ──

[importlinter:contract:notify-isolation]
name = Эталон (C3): notify не знает про composition root и другие модули
type = forbidden
source_modules =
    app.modules.notify
forbidden_modules =
    app.bootstrap
    app.main
    app.modules.access
    app.modules.audit
    app.modules.cars
    app.modules.docs
    app.modules.employees
    app.modules.night
    app.modules.settings
    app.modules.timesheet
allow_indirect_imports = True

[importlinter:contract:access-private]
name = R3: domain/adapters/interface access приватны
type = forbidden
source_modules =
    app.modules.audit
    app.modules.cars
    app.modules.docs
    app.modules.employees
    app.modules.night
    app.modules.notify
    app.modules.settings
    app.modules.timesheet
forbidden_modules =
    app.modules.access.domain
    app.modules.access.adapters
    app.modules.access.interface
allow_indirect_imports = True

[importlinter:contract:audit-private]
name = R3: domain/adapters/interface audit приватны
type = forbidden
source_modules =
